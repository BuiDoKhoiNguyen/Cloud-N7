# Mẫu cho file .env của back-end
# Sao chép file này thành .env và cập nhật giá trị

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cloud-n7

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URI=amqp://localhost

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRY=7d

# Cloudinary (cũ)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=uploads

# AWS S3 + CloudFront (mới)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=cloud-n7-media
CLOUDFRONT_DOMAIN=https://dxxxxxxxxxxxxx.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=EXXXXXXXXXX # Sử dụng cho cache invalidation

# Server
PORT=3000
NODE_ENV=development
