{
  "name": "back-end",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "test": "mocha --timeout 20000 './test/**/*.test.js'",
    "test:dev": "mocha --watch --parallel --timeout 20000 './test/**/*.test.js'",
    "migrate-cloudinary": "node scripts/migrate-cloudinary-to-s3.js",
    "deploy-aws": "aws cloudformation create-stack --stack-name cloud-n7-media-infrastructure --template-body file://../cloudformation/media-infrastructure.yml --capabilities CAPABILITY_NAMED_IAM",
    "update-aws": "aws cloudformation update-stack --stack-name cloud-n7-media-infrastructure --template-body file://../cloudformation/media-infrastructure.yml --capabilities CAPABILITY_NAMED_IAM",
    "security-check": "bash scripts/security-check.sh",
    "invalidate-cdn": "aws cloudfront create-invalidation --distribution-id $CLOUDFRONT_DISTRIBUTION_ID --paths \"/*\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.5",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "joi": "^17.12.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "redis": "^4.6.13",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "chai": "^5.1.0",
    "chai-http": "^4.4.0",
    "mocha": "^10.4.0",
    "morgan": "^1.10.0",
    "nodemon": "^3.0.3"
  }
}
