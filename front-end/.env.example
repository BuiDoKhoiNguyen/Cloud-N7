# Mẫu file .env cho frontend
# Sao chép file này thành .env và cập nhật giá trị

# Server URL
VITE_SERVER_URL=http://localhost:3000/

# CloudFront Domain (cần thiết để phân biệt file từ CloudFront vs Cloudinary)
VITE_CLOUDFRONT_DOMAIN=https://dxxxxxxxxxxxxx.cloudfront.net

# Môi trường
VITE_ENV=development
